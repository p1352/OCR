# --- LaurentConvert : exemple de configuration ---
# Copier ce fichier en .env et renseigner les valeurs réelles.
# Le .env ne doit JAMAIS être commité.

# Django
DJANGO_SECRET_KEY=changez-moi-par-une-cle-longue-et-aleatoire
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Base de données : laisser MYSQL_NAME vide pour SQLite (développement).
# Renseigner ces valeurs pour MariaDB en production.
MYSQL_NAME=
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Groq (API compatible OpenAI, modèles vision)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_TIMEOUT_SECONDS=120
# 0 = laisser Groq décider ; sinon borne de tokens de sortie (max selon le modèle)
GROQ_MAX_TOKENS=0

# CORS : origines autorisées du frontend (séparées par des virgules)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/tiff,image/bmp
MEDIA_ROOT=

# JWT (durées en minutes / jours)
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
